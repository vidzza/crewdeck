# Crewdeck settings on the Pi: /opt/crewdeck/crewdeck.env
# The installer creates this file once and never overwrites it.

# The bar's time zone (used in notification text such as "Fri Nov 21, 8:00 PM–3:00 AM")
TZ=America/Denver

# Local port Crewdeck listens on (127.0.0.1 only). Must not be used by anything else on the Pi.
# The Cloudflare Tunnel points scheduler.hackxolotl.com to http://localhost:<this port>.
CREWDECK_PORT=8095

# The public address of the app (CORS).
CREWDECK_ORIGINS=https://scheduler.hackxolotl.com

# Optional: code required on the first-time setup screen (creating the owner).
CREWDECK_SETUP_CODE=

# Optional: alerts to a Telegram group for admins.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
